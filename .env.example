# Example environment configuration for AETHER-GENESIS.
# Copy to .env and replace values as needed.

# LLM provider configuration
LLM_PROVIDER=development_mock
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Governance settings
AETHER_POLICY_MODE=STRICT
AETHER_ALLOW_NETWORK=false
AETHER_ALLOWED_ROOTS=./workspace
AETHER_MAX_TOKEN_BUDGET=50000
AETHER_MAX_TIME_BUDGET=300

# Observability
AETHER_LOG_LEVEL=INFO
